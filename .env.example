# UPS GO — variables para docker-compose.yml (despliegue de la API).
# Copia este archivo a `.env` (no se versiona) y reemplaza TODOS los placeholders.
# Para desarrollo local de la API sin Docker usa apps/api/.env.example.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Usa solo caracteres alfanuméricos en la contraseña (se inserta en una URL).
POSTGRES_USER=ups_go
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=ups_go

# ── JWT (genera valores largos y distintos: `openssl rand -base64 48`) ────────
# En producción la API rechaza valores que empiecen con "change-me".
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Autenticación OTP ─────────────────────────────────────────────────────────
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Dominios que pueden auto-registrarse como STUDENT (separados por coma).
ALLOWED_EMAIL_DOMAINS=ups.edu.ec,est.ups.edu.ec
# Correos que reciben rol SUPER_ADMIN al iniciar sesión (separados por coma).
SUPER_ADMIN_EMAILS=

# ── SMTP (obligatorio en producción: envía los códigos OTP) ───────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp_user
SMTP_PASS=smtp_password
SMTP_FROM=noreply@ups.edu.ec

# ── Red / seguridad ───────────────────────────────────────────────────────────
# Orígenes web permitidos por CORS (vacío = sin orígenes de navegador; la app
# móvil no usa CORS). Ejemplo: https://admin.tu-dominio.com
CORS_ORIGINS=
# Saltos de proxy confiables para rate limiting por IP (1 = un reverse proxy).
TRUST_PROXY_HOPS=1
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# ── Swagger (déjalo apagado en producción salvo que lo protejas) ──────────────
SWAGGER_ENABLED=false
SWAGGER_PATH=docs
# URL pública de la API, usada solo como servidor en la documentación Swagger.
APP_PUBLIC_URL=

# ── Opcionales ────────────────────────────────────────────────────────────────
APP_NAME=UPS GO API
# Solo con docker-compose.local.yml: puerto publicado en el host.
API_PORT=3000

# ── Pruebas sin dominio ni SMTP (NO usar en producción) ───────────────────────
# APP_ENV=development + AUTH_DEV_EXPOSE_OTP=true devuelve el OTP en la respuesta
# de /auth/request-code. En producción la API rechaza esa combinación.
APP_ENV=production
AUTH_DEV_EXPOSE_OTP=false
# Túnel ngrok opcional (COMPOSE_PROFILES=tunnel). El authtoken es un secreto.
COMPOSE_PROFILES=
NGROK_AUTHTOKEN=
NGROK_URL=
