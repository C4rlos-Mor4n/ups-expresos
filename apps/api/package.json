{
  "name": "ups-expresos-api",
  "version": "1.0.0",
  "description": "UPS GO API - institutional transport operations backend",
  "private": true,
  "main": "dist/src/main.js",
  "scripts": {
    "start:dev": "nest start --watch",
    "build": "nest build",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:calendar:integration": "jest --runInBand --runTestsByPath src/modules/calendar/calendar-resolver.integration.spec.ts",
    "test:scheduled-departure:integration": "jest --runInBand --runTestsByPath src/modules/calendar/scheduled-departure.integration.spec.ts",
    "test:scheduled-departure-materializer:integration": "jest --runInBand --runTestsByPath src/modules/calendar/scheduled-departure-materializer.integration.spec.ts",
    "test:phase6:operational-integration": "jest --runInBand --runTestsByPath src/modules/operational/operational.integration.spec.ts",
    "test:phase6:api-integration": "jest --runInBand --runTestsByPath src/modules/operational/operational-api.integration.spec.ts",
    "test:e2e": "DATABASE_URL=\"postgresql://ups_test:ups_test@localhost:5434/ups_test?schema=public\" prisma migrate deploy && jest --config ./test/jest-e2e.json",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:demo": "tsx scripts/seed-demo.ts",
    "prisma:reset:demo": "UPS_GO_DEMO_MODE=cleanup UPS_GO_DEMO_CONFIRM=DELETE tsx scripts/seed-demo.ts && tsx scripts/seed-demo.ts",
    "prisma:studio": "prisma studio",
    "export:openapi": "ts-node src/export-openapi.ts",
    "generate:mobile-contracts": "pnpm export:openapi && openapi-typescript openapi-spec.json --output ../mobile/src/api/generated/openapi.ts",
    "verify:mobile-contracts": "pnpm generate:mobile-contracts && git diff --exit-code -- ../mobile/src/api/generated/openapi.ts",
    "test:openapi": "ts-node test/swagger/openapi-contract.spec.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@common/(.*)$": "<rootDir>/common/$1",
      "^@config/(.*)$": "<rootDir>/config/$1",
      "^@database/(.*)$": "<rootDir>/database/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1"
    }
  },
  "dependencies": {
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.2.0",
    "nodemailer": "^9.0.6",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.27",
    "@prisma/config": "6.19.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.6.0",
    "jest": "^29.7.0",
    "openapi-typescript": "7.10.1",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3"
  }
}
