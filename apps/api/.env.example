NODE_ENV=development
PORT=3000
APP_NAME="UPS ExpresosApp API"

DATABASE_URL="postgresql://ups_user:ups_password@localhost:5433/ups_expresos?schema=public"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
AUTH_DEV_EXPOSE_OTP=false

ALLOWED_EMAIL_DOMAINS="ups.edu.ec,est.ups.edu.ec"
SUPER_ADMIN_EMAILS=""

# Seed de datos demo (prisma/seed.ts). Default: incluye demo data salvo NODE_ENV=production.
# Valores: 1|true|yes => incluir siempre, 0|false|no => omitir siempre
SEED_INCLUDE_DEMO_DATA=true

CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:5173"

# URL pública del despliegue (solo para documentación Swagger, opcional)
# APP_PUBLIC_URL="https://tu-dominio.com"

SWAGGER_ENABLED=true
SWAGGER_PATH="docs"

# Throttling (rate limiting)
THROTTLE_TTL=60000
THROTTLE_LIMIT=60
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=3

# Hops de proxy confiable para rate limiting por IP (0 = sin proxy, cliente directo)
TRUST_PROXY_HOPS=0

# SMTP (required in production)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="smtp_user"
SMTP_PASS="smtp_password"
SMTP_FROM="noreply@ups.edu.ec"
