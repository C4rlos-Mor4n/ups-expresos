# UPS GO API — variables de entorno para desarrollo local (sin Docker).
# Copia este archivo a `.env` (no se versiona). Para el despliegue con Docker usa
# el `.env.example` de la raíz del repositorio. Referencia completa: docs/api/configuration.md

# ── Aplicación ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME="UPS GO API"

# ── Base de datos ─────────────────────────────────────────────────────────────
# Coincide con `docker compose -f docker-compose.dev.yml up -d` (PostgreSQL en 5433).
DATABASE_URL="postgresql://ups_user:ups_password@localhost:5433/ups_expresos?schema=public"

# ── JWT ───────────────────────────────────────────────────────────────────────
# En producción la API rechaza valores que empiecen con "change-me".
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Autenticación OTP ─────────────────────────────────────────────────────────
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Devuelve el OTP en la respuesta de /auth/request-code. Solo desarrollo;
# la API falla al iniciar si está en true con NODE_ENV=production.
AUTH_DEV_EXPOSE_OTP=false
# Dominios que pueden auto-registrarse como STUDENT (fuente de verdad: esta variable).
ALLOWED_EMAIL_DOMAINS="ups.edu.ec,est.ups.edu.ec"
# Correos que reciben rol SUPER_ADMIN (login y `pnpm prisma:seed`), separados por coma.
SUPER_ADMIN_EMAILS=""

# ── HTTP ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:5173"
# Saltos de proxy confiables para rate limiting por IP (0 = cliente directo).
TRUST_PROXY_HOPS=0
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# ── Swagger ───────────────────────────────────────────────────────────────────
SWAGGER_ENABLED=true
SWAGGER_PATH="docs"
# URL pública del despliegue (solo para el selector de servidor de Swagger, opcional).
# APP_PUBLIC_URL="https://api.tu-dominio.com"

# ── SMTP ──────────────────────────────────────────────────────────────────────
# Obligatorio en producción. En desarrollo, si faltan, los códigos OTP no se envían
# por correo: usa AUTH_DEV_EXPOSE_OTP=true para obtenerlos en la respuesta.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="smtp_user"
SMTP_PASS="smtp_password"
SMTP_FROM="noreply@ups.edu.ec"

# ── Solo QA / pruebas (no son parte de la configuración de la aplicación) ─────
# Archivo .env alternativo para la API (usado por tests E2E y scripts).
# API_ENV_FILE=".env.test"
# Habilita `pnpm qa:showcase:reset` (borra y recrea datos). Solo bases locales descartables.
# CONFIRM_LOCAL_QA_RESET=YES
# Banderas de pruebas de integración contra PostgreSQL aislado (ver docs/api/testing.md):
# RUN_CALENDAR_INTEGRATION, RUN_SCHEDULED_DEPARTURE_INTEGRATION,
# RUN_SCHEDULED_DEPARTURE_MATERIALIZER_INTEGRATION, RUN_PHASE_6_OPERATIONAL_INTEGRATION,
# RUN_PHASE_6_API_INTEGRATION, RUN_ADMIN_SCHEDULE_INTEGRATION, RUN_AUTH_INTEGRATION,
# RUN_REFERENCE_INTEGRATION, RUN_GOLDEN_INTEGRATION  (= true para activarlas)
