# Puerta de entrada pública (ngrok / dominio) → servicios internos.
#   /panel/*  → panel administrativo (Next.js)
#   resto     → API NestJS (app móvil, webhook Hunter, /health)
{
	admin off
	auto_https off
	servers {
		# ngrok y el proxy del host son redes privadas: se respeta su X-Forwarded-For/Proto.
		trusted_proxies static private_ranges
	}
}

:80 {
	# Log de acceso en stdout (docker logs / Dokploy): método, ruta, estado, IP real y duración.
	# No registra cabeceras ni cuerpos, y se oculta ?api_key= de la URL, así que la API key
	# del webhook no queda en el log.
	log {
		output stdout
		format filter {
			wrap console
			request>headers delete
			request>tls delete
			request>uri query {
				replace api_key REDACTED
			}
		}
	}
	encode gzip
	request_body {
		max_size 2MB
	}
	handle /panel* {
		reverse_proxy web:3001
	}
	handle {
		reverse_proxy api:3000
	}
}
